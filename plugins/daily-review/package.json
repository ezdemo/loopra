{
  "name": "daily-review",
  "version": "1.0.0",
  "description": "示例插件，默认关闭。启用后能看到设置页、侧栏、菜单、工具、技能、子代理和定时任务",
  "loopra": {
    "plugin": "./plugin.js",
    "defaultEnabled": false,
    "icon": "calendar",
    "ui": {
      "settings": "./ui/index.html",
      "sidebar": {
        "title": "每日回顾",
        "icon": "calendar",
        "page": "./ui/index.html"
      },
      "menu": {
        "title": "每日回顾",
        "icon": "calendar",
        "children": [
          { "id": "focus", "title": "关注点", "icon": "pen", "page": "./ui/index.html" },
          { "id": "about", "title": "说明", "icon": "book-open", "page": "./ui/about.html" }
        ]
      }
    },
    "skill": "./SKILL.md",
    "subagent": {
      "name": "回顾",
      "description": "按回顾清单做只读检查",
      "readOnly": true,
      "file": "./AGENT.md"
    },
    "schedule": {
      "name": "每日回顾",
      "message": "请用几句话回顾：今天值得记住的一件事、一个还没做完的问题、明天可以先做的一步。不要调用工具。",
      "cron": "0 0 9 * * ?"
    }
  }
}
