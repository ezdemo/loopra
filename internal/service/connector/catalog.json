      "docsUrl": "https://developer.monday.com/apps/docs/mondaycom-mcp-integration",
      "transport": { "type": "streamable", "url": "https://mcp.monday.com/mcp" },
      "auth": { "type": "oauth" }
    },
    {
      "id": "airtable",
      "name": "Airtable",
      "category": "project",
      "color": "#18BFFF",
      "description": "读取和写入 Airtable 表格记录。",
      "capabilities": ["查询记录", "创建与更新记录", "查看表结构"],
      "docsUrl": "https://support.airtable.com/docs/using-the-airtable-mcp-server",
      "transport": { "type": "streamable", "url": "https://mcp.airtable.com/mcp" },
      "auth": { "type": "oauth" }
    },
    {
      "id": "canva",
      "name": "Canva 可画",
      "category": "design",
      "color": "#00C4CC",
      "description": "搜索和生成 Canva 设计。",
      "capabilities": ["搜索设计", "生成设计", "导出设计"],
      "docsUrl": "https://www.canva.dev/docs/mcp/",
      "transport": { "type": "streamable", "url": "https://mcp.canva.com/mcp" },
      "auth": { "type": "oauth" }
    },
    {
      "id": "amap",
      "name": "高德地图",
      "category": "life",
      "color": "#2F7BFF",
      "description": "地点搜索、路线规划与天气查询。",
      "capabilities": ["搜索地点与周边", "驾车/公交/步行/骑行路线规划", "天气查询"],
      "docsUrl": "https://developer.amap.com/api/mcp-server/gettingstarted",
      "transport": { "type": "streamable", "url": "https://mcp.amap.com/mcp?key={{key}}" },
      "auth": {
        "type": "token",
        "helpUrl": "https://developer.amap.com/api/mcp-server/gettingstarted",
        "fields": [{ "key": "key", "label": "Web 服务 Key", "secret": true }]
      }
    },
    {
      "id": "github",
      "name": "GitHub",
      "category": "developer",
      "color": "#181717",
      "description": "管理仓库、Issue 与 Pull Request。",
      "capabilities": ["搜索代码与仓库", "处理 Issue", "审阅 Pull Request"],
      "docsUrl": "https://github.com/github/github-mcp-server",
      "transport": {
        "type": "streamable",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": { "Authorization": "Bearer {{token}}" }
      },
      "auth": {
        "type": "token",
        "helpUrl": "https://github.com/settings/personal-access-tokens",
        "fields": [{ "key": "token", "label": "Personal Access Token", "secret": true }]
      }
    },
    {
      "id": "sentry",
      "name": "Sentry",
      "category": "developer",
      "color": "#362D59",
      "description": "查询错误与性能问题。",
      "capabilities": ["搜索问题", "查看错误详情"],
      "docsUrl": "https://docs.sentry.io/product/sentry-mcp/",
      "transport": { "type": "streamable", "url": "https://mcp.sentry.dev/mcp" },
      "auth": { "type": "oauth" }
    }
  ]
