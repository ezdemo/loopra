{
  "name": "loopra-front",
  "version": "26.9.91",
  "private": true,
  "main": "dist/main/main.cjs",
  "type": "module",
  "description": "Loopra - 智能AI代码助手前端",
  "homepage": "https://loopra.dev",
  "author": "Loopra Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "pnpm typecheck:web && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build:renderer": "pnpm typecheck:web && vite build --outDir dist/renderer",
    "build:main": "vite build -c vite.main.config.mjs --outDir dist/main",
    "build:preload": "vite build -c vite.preload.config.mjs --outDir dist/main --emptyOutDir false",
    "build:vite": "pnpm build:renderer && pnpm build:main && pnpm build:preload",
    "package": "pnpm build:vite && electron-builder",
    "package:mac": "pnpm build:vite && electron-builder --mac",
    "package:win": "pnpm build:vite && electron-builder --win",
    "package:linux": "pnpm build:vite && electron-builder --linux",
    "package:all": "pnpm build:vite && electron-builder --mac --win --linux",
    "typecheck:web": "tsc -b web/tsconfig.json",
    "test:web": "node --test web/tests/*.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nextui-org/react": "2.6.11",
    "@shikijs/langs": "^3.23.0",
    "@shikijs/themes": "^3.23.0",
    "@vscode/codicons": "0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.6.7",
    "diff": "8.0.2",
    "dompurify": "^3.4.10",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.18.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^15.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^2.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.23.0",
    "vue": "^3.4.21",
    "vue-router": "4.5.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "6.0.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/test-utils": "^2.4.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "8.0.5",
    "vitest": "^1.3.1",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "keywords": [
    "ai",
    "agent",
    "code-assistant",
    "vue3",
    "vite"
  ]
}
