<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Loopra 拓展包（Solon H-SPI）示例项目。

      构建产物 target/loopra-extra-demo-1.0.0.jar 即一个可安装的拓展包：
        - 设置页「拓展包」栏粘贴 jar 路径安装，或
        - POST /api/extpacks/install {"source": "<jar 路径或直链>"}

      演示内容：
        - 工具：demo-server-time（服务器时间）、demo-greeting（问候）
        - 拦截器：BEFORE_STEP 写入变量 demoExtApplied
        - 路由：/api/ext-demo/*（Solon @Controller，随插件容器挂载）
        - Solon 插件生命周期：DemoExtPackPlugin（start/stop）
    -->
    <groupId>site.sorghum</groupId>
    <artifactId>loopra-extra-demo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Loopra Extra Demo</name>
    <description>Loopra 拓展包（Solon H-SPI）示例：工具 + 拦截器 + 路由 + Solon 插件</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <loopra.version>26.9.91</loopra.version>
        <cutin.version>1.0-SNAPSHOT</cutin.version>
        <solon.version>4.1.1</solon.version>
        <junit.version>5.10.2</junit.version>
        <slf4j.version>2.0.17</slf4j.version>
    </properties>

    <dependencies>
        <!-- 桥接 SPI：LoopraExtPackBridge（运行期由宿主 Loopra 提供） -->
        <dependency>
            <groupId>site.sorghum.agent</groupId>
            <artifactId>loopra</artifactId>
            <version>${loopra.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Agent 引擎接口：Tool / LoopInterceptor / InterceptPoint 等（运行期由宿主提供） -->
        <dependency>
            <groupId>site.sorghum</groupId>
            <artifactId>cutin</artifactId>
            <version>${cutin.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Solon 容器：@Controller 路由与 org.noear.solon.core.Plugin（运行期由宿主提供） -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-web</artifactId>
            <version>${solon.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 测试：全链路冒烟（安装 → 桥接 → 停止 → 卸载） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-test-junit5</artifactId>
            <version>${solon.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
